# Copy to backend/.env for local development.
MONGO_URL=mongodb://localhost:27017
DB_NAME=drivehive
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Local http can't use Secure cookies. In production (Render) this is on.
COOKIE_SECURE=false

# Optional
# STRIPE_API_KEY=sk_test_...        # without it, Boost runs in demo mode (no charges)
# STRIPE_WEBHOOK_SECRET=whsec_...
# ADMIN_EMAIL=you@example.com       # admin is created only when BOTH are set
# ADMIN_PASSWORD=...
